{
  "manifest_version": 3,
  "name": "Wave Shifter - key, tune, pitch, speed, tempo, volume, EQ - all-in-one",
  "short_name": "Wave Shifter",
  "description": "Ultimate real-time audio enhancer: pitch shift, EQ, volume boost & speed control for videos and music on any website.",
  "author": "Unsonet <https://github.com/Unsonet>",
  "homepage_url": "https://unsonet.onrender.com/",
  "version": "1.3",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "src/img/icon-128.png",
    "48": "src/img/icon-48.png",
    "32": "src/img/icon-32.png",
    "16": "src/img/icon-16.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js",
        "__pitch_shifter_worklet.js",
        "src/js/SignalsmithStretch.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "worklet_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}